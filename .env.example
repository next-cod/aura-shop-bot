# Create a bot in @BotFather and paste its token here.
BOT_TOKEN=

# Chat ID of a private staff group. The bot forwards reports, ideas and paid orders here.
# Use a negative number for a Telegram group, e.g. -1001234567890.
STAFF_CHAT_ID=

# Optional manager username. The manager sends /manager to the bot once to receive ideas, bugs and complaints.
MANAGER_USERNAME=manager_mcaura

# Public links
SITE_URL=https://mcaura.ru
DISCORD_URL=https://discord.gg/JP6jSt7DA
TELEGRAM_CHANNEL_URL=https://t.me/aura_grief

# Current Minecraft link bridge. The bot never falls back to an old host.
# This API implements /telegram/link/*, /telegram/login/* and /telegram/action.
AURA_TELEGRAM_API_URL=
AURA_TELEGRAM_SECRET=

# Optional. On Amvera this is already set by amvera.yml.
DATA_DIR=/data

# Minecraft bridge used for account linking, login confirmations and session notifications.
AURA_TELEGRAM_API_URL=http://213.171.18.146:22243
AURA_TELEGRAM_SECRET=
